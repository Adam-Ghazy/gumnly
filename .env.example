# Runtime konfigurasi — salin ke .env dan isi. JANGAN commit .env.
# Origin kanonik aplikasi (wajib; produksi wajib HTTPS)
APP_ORIGIN=http://localhost:3000

# Lokasi database SQLite (di luar public/, di-ignore git). Default: data/gumnly.sqlite
DATABASE_PATH=data/gumnly.sqlite

# Kredensial admin — hasilkan dengan: npm run admin:generate
# Tanpa variabel ini, login admin jujur menampilkan "belum dikonfigurasi" (tidak ada akun bawaan).
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Pengiriman email pertanyaan. "disabled" = pertanyaan hanya tersimpan lokal (jujur diinformasikan ke pengirim).
# "resend" membutuhkan RESEND_API_KEY, MAIL_FROM, MAIL_TO.
MAIL_PROVIDER=disabled
# RESEND_API_KEY=
# MAIL_FROM=
# MAIL_TO=
# MAIL_TIMEOUT_MS=5000
